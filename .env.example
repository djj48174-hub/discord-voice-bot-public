# ==========================================================
#  انسخ هذا الملف باسم  .env  واملأ القيم
# ==========================================================

DISCORD_TOKEN=

# معرف السيرفر (اختياري — يسرّع ظهور أوامر السلاش)
GUILD_ID=

# معرف الروم الصوتي اللي يقعد فيه البوت 24 ساعة
VOICE_CHANNEL_ID=

# كل كم ثانية يفحص الاتصال ويعيد الدخول إذا طلع
CHECK_SECONDS=30

# true = يرجع للروم المحدد لو نقله أحد | false = يخليه وين ما نقله أحد
LOCK_TO_CHANNEL=true

# ------------------- إعدادات الموسيقى (اختيارية) -------------------

# مستوى الصوت الافتراضي (0-100)
DEFAULT_VOLUME=70

# مسار ffmpeg (اتركه فاضي لاستخدام ffmpeg-static المحزّم أو ffmpeg من PATH)
# على Docker نضبطه على /usr/bin/ffmpeg
# FFMPEG_PATH=

# مسار yt-dlp (اتركه فاضي للبحث التلقائي في مجلد bin/ أو PATH)
# YTDLP_PATH=

# ملف كوكيز يوتيوب — مسار ملف (اختياري)
# YTDLP_COOKIES=

# أو: محتوى ملف الكوكيز بصيغة Base64 (مفيد للنشر على Railway)
# YTDLP_COOKIES_B64=

# ترتيب "عملاء" يوتيوب اللي نجرّبها لتجاوز حجب السيرفر
# YTDLP_CLIENTS=android,tv,android_vr,ios,mweb,tv_simply,web_embedded,web_safari,web,default

# كم ثانية ننتظر أول بايت صوت قبل ما نعتبر المحاولة فاشلة
# STREAM_TIMEOUT_MS=15000

# رابط فيديو يُستخدم لفحص العملاء عند بدء البوت
# YTDLP_PROBE_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# إعدادات إضافية تُمرَّر لـ yt-dlp (اختياري)
# YTDLP_EXTRA_ARGS=

# ------------------- المحادثة / السوالف (اختيارية) -------------------

# مفتاح Groq — مجاني وحصته سخية (الأفضل للمحادثة)
# احصل عليه من: https://console.groq.com/keys
# GROQ_API_KEY=

# اسم موديل Groq (اختياري — في سلسلة بدائل تلقائية + اكتشاف تلقائي للمتاح)
# GROQ_MODEL=qwen/qwen3.8-27b

# مفتاح Google Gemini — مجاني لكن الحصة صغيرة (20 رسالة/يوم لكل موديل)
# احصل عليه من: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# الموديل (اختياري — في سلسلة بدائل تلقائية لكل مزوّد)
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# تشغيل/إيقاف السوالف (true/false)
# CHAT_ENABLED=true

# ذاكرة المحادثة (كم رسالة يتذكر)
# CHAT_MEMORY=12

# مهلة انتظار رد الذكاء الاصطناعي بالمللي ثانية
# AI_TIMEOUT_MS=20000

# رتبة البوت في السيرفر (فاضية = تعطيل)
# BOT_ROLE_NAME=بوت 24/7
# BOT_ROLE_COLOR=#5865F2

# اسم البوت في السوالف
# BOT_NAME=بوت 24/7

# لو فعّلت "Message Content Intent" في بوابة المطورين → خلها true
# (بدونها البوت يرد على المنشن @ والخاص فقط)
# ENABLE_MESSAGE_CONTENT=false
