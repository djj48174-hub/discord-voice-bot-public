{
  "name": "discord-voice-bot",
  "version": "2.0.0",
  "private": true,
  "description": "بوت ديسكورد يقعد 24/7 في الروم الصوتي + يشغّل أغاني",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "postinstall": "node scripts/download-ytdlp.js",
    "check": "node scripts/check.js",
    "test": "node test/voice-toggle.test.js && node test/music-intents.test.js",
    "health": "node scripts/health.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "msedge-tts": "^2.1.0",
    "opusscript": "^0.1.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
