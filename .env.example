# ==========================================================
#  انسخ هذا الملف باسم  .env  واملأ القيم
# ==========================================================

DISCORD_TOKEN=

# معرف السيرفر (اختياري — يسرّع ظهور أوامر السلاش)
GUILD_ID=

# معرف الروم الصوتي اللي يقعد فيه البوت 24 ساعة
VOICE_CHANNEL_ID=

# كل كم ثانية يفحص الاتصال ويعيد الدخول إذا طلع
CHECK_SECONDS=30

# true = يرجع للروم المحدد لو نقله أحد | false = يخليه وين ما نقله أحد
LOCK_TO_CHANNEL=true

# ------------------- إعدادات الموسيقى (اختيارية) -------------------

# مستوى الصوت الافتراضي (0-100)
DEFAULT_VOLUME=70

# مسار ffmpeg (اتركه فاضي لاستخدام ffmpeg-static المحزّم أو ffmpeg من PATH)
# على Docker نضبطه على /usr/bin/ffmpeg
# FFMPEG_PATH=

# مسار yt-dlp (اتركه فاضي للبحث التلقائي في مجلد bin/ أو PATH)
# YTDLP_PATH=

# ملف كوكيز يوتيوب — مسار ملف (اختياري)
# YTDLP_COOKIES=

# أو: محتوى ملف الكوكيز بصيغة Base64 (مفيد للنشر على Railway)
# YTDLP_COOKIES_B64=

# ترتيب "عملاء" يوتيوب اللي نجرّبها لتجاوز حجب السيرفر
# YTDLP_CLIENTS=android,tv,android_vr,ios,mweb,tv_simply,web_embedded,web_safari,web,default

# كم ثانية ننتظر أول بايت صوت قبل ما نعتبر المحاولة فاشلة
# STREAM_TIMEOUT_MS=15000

# رابط فيديو يُستخدم لفحص العملاء عند بدء البوت
# YTDLP_PROBE_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# إعدادات إضافية تُمرَّر لـ yt-dlp (اختياري)
# YTDLP_EXTRA_ARGS=

# ------------------- المحادثة / السوالف (اختيارية) -------------------

# مفتاح Groq — مجاني وحصته سخية (الأفضل للمحادثة)
# احصل عليه من: https://console.groq.com/keys
# GROQ_API_KEY=

# اسم موديل Groq (اختياري — في سلسلة بدائل تلقائية + اكتشاف تلقائي للمتاح)
# GROQ_MODEL=qwen/qwen3.8-27b

# مفتاح Google Gemini — مجاني لكن الحصة صغيرة (20 رسالة/يوم لكل موديل)
# احصل عليه من: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# الموديل (اختياري — في سلسلة بدائل تلقائية لكل مزوّد)
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# تشغيل/إيقاف السوالف (true/false)
# CHAT_ENABLED=true

# ذاكرة المحادثة (كم رسالة يتذكر)
# CHAT_MEMORY=12

# مهلة انتظار رد الذكاء الاصطناعي بالمللي ثانية
# AI_TIMEOUT_MS=20000

# رتبة البوت في السيرفر (فاضية = تعطيل)
# BOT_ROLE_NAME=بوت 24/7
# BOT_ROLE_COLOR=#5865F2

# اسم البوت في السوالف
# BOT_NAME=بوت 24/7

# لو فعّلت "Message Content Intent" في بوابة المطورين → خلها true
# (بدونها البوت يرد على المنشن @ والخاص فقط)
# ENABLE_MESSAGE_CONTENT=false

# ------------------- المحادثة الصوتية (اختيارية) -------------------

# صوت البوت: رجالي خليجي ثابت
# الأساسي: ar-SA-HamedNeural (سعودي)
# بدائل خليجية: ar-AE-HamdanNeural (إماراتي), ar-KW-FahedNeural (كويتي),
#               ar-QA-MoazNeural (قطري), ar-BH-AliNeural (بحريني), ar-OM-AbdullahNeural (عماني)
# TTS_VOICE=ar-SA-HamedNeural
# TTS_RATE=+8%

# صوت Groq Orpheus الرجالي (يحتاج موافقة شروط مرة واحدة من لوحة Groq)
# خيارات رجالية: abdullah, fahad, sultan
# GROQ_TTS_VOICE=abdullah

# تشغيل/إيقاف السماع والرد بالصوت (true/false)
# VOICE_CHAT=true

# كلمة تنبيه (فاضية = يرد على أي كلام)
# VOICE_WAKE_WORD=

# كم ملّي ثانية صمت تعتبر نهاية كلام المتحدث (أعلى = ما يقطع كلامك)
# VOICE_SILENCE_MS=1100

# أقصى طول للمقطع الواحد
# VOICE_MAX_MS=15000

# أقل عدد بايتات نعتبرها كلام حقيقي (نمنع النقرات)
# VOICE_MIN_BYTES=1200

# ترتيب محرّكات النطق.
# الترتيب الافتراضي: edge (صوت سعودي رجالي — ثابت وما يتقيّد) ثم groq ثم google.
# ليش Edge أول؟ لأن Groq Orpheus يتقيّد كثير (429) فيصير الصوت يتغيّر فجأة.
# TTS_ORDER=edge,groq,google

# موديل النطق من Groq — يحتاج موافقة شروط مرة واحدة:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-arabic-saudi
# GROQ_TTS_MODEL=canopylabs/orpheus-arabic-saudi

# صوت مايكروسوفت الاحتياطي
# TTS_VOICE=ar-SA-HamedNeural
# TTS_RATE=+8%

# تفريغ الكلام إلى نص (Groq Whisper)
# whisper-large-v3 أدق للعامية (turbo أسرع لكن يغلط أكثر)
# STT_MODEL=whisper-large-v3

# تلميح اختياري لـ Whisper. ⚠️ خليه فاضي — التلميح الطويل يخلي الموديل
# يهلوس ويردّد التلميح نفسه على الصمت (صار معنا فعلاً).
# STT_PROMPT=

# حدّ الصوت: نتجاهل المقاطع اللي مستوى أعلاها أقل من هذا (dB) لمدّة طويلة = صمت/ضجيج
# STT_MIN_DB=-38
# STT_HARD_DB=-50

# سرعة النطق (1 = عادي، 1.12 = أسرع بـ12% بنفس النبرة)
# TTS_SPEED=1.12

# true = يطبع رسائل تصحيح الصوت (WS/UDP/DAVE) في السجلات
# VOICE_DEBUG=false

# ------------------- أوامر الصوت (تُنفَّذ فعلياً) -------------------
# البوت ينفّذ الأوامر المنطوقة في الروم:
#   "شغّل لي كاظم الساهر"    -> يشغّل الأغنية (ويأكد بصوته)
#   "وقّف الموسيقى" / "اسكت" -> يوقف الأغنية
#   "الأغنية اللي بعدها"     -> يتخطى
#   "وقفها شوي" / "كمّل"     -> إيقاف مؤقت / متابعة
#   "ارفع الصوت" / "نزّل الصوت"
#   "كرّر الأغنية" / "لا تكرّر"
#   "وش شغال الحين"
#   "اطلع من الروم"          -> يطلع (مع تأكيد صوتي)
#   "ادخل الروم"             -> يرجع للروم
#   "وقف الرد الصوتي"        -> يوقف الرد بالكلام (يبقى يسمع كلمة التشغيل فقط)
#   "شغّل الرد الصوتي"       -> يرجّع الرد بالكلام
#   "لا مو هذي" / "غيرها"    -> إذا شغّل أغنية غلط، يشغّل البديل الأقرب
# ونفس الأوامر تشتغل كتابةً (مع منشن البوت) أو بأمر /voice → تشغيل/إيقاف

# ------------------- دقة اختيار الأغنية (مهم) -------------------
# البوت يبحث عن 10 نتائج ويقيّمها (عنوان + مدة + منع الريمكس/الكوف)
# ويشغّل الأقرب فقط. لو ما فيه مطابقة واضحة، يعتذر بدل ما يشغّل أغنية عشوائية.
# MUSIC_MIN_SCORE=0.45
# SC_CANDIDATES=10
# YT_CANDIDATES=6
# PREFER_SOURCE=youtube   # لو تبي يوتيوب أول بدل ساوند كلاود


